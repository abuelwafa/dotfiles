{
  "permission": {
    "*": "ask",
    "path": {
      "*": "ask",
      "/proc/**": "deny",
      "/sys/**": "deny",
      "/home/node/.pi/**": "deny",
      "**/.ssh/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "/home/node/workspace/**": "allow",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "ask",
      "sudo *": "deny"
    },
    "external_directory": "ask"
  }
}
