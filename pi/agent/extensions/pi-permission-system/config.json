{
  "permission": {
    "*": "ask",
    "path": {
      "*": "ask",
      "/proc/**": "deny",
      "/sys/**": "deny",
      "/home/node/.pi/**": "deny",
      "**/.ssh/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "/home/node/workspace/**": "allow",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "ask",
      "sudo *": "deny",
      "go install *": "deny",
      "go get *": "deny",
      "apt *": "deny",
      "npm *": "deny",
      "pip *": "deny",
      "sleep *": "allow",
      "which *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "cut *": "allow"
    },
    "read": {
      "*": "ask",
      "/home/node/workspace/**": "allow"
    },
    "write": {
      "*": "ask",
      "/home/node/workspace/**": "allow",
      "/dev/null": "allow"
    },
    "ask_user_question": "allow",
    "web_search": "allow",
    "todo": "allow",
    "skill": {
      "*": "ask",
      "grilling": "allow"
    },
    "external_directory": "ask"
  }
}
